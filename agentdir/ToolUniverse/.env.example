# ---------------------------------------------------------------------------
# ToolUniverse Agent credentials — copy this file to `.env` and edit.
# The .env file is .gitignore'd and MUST NOT be committed.
# ---------------------------------------------------------------------------

# ---- Option A: Azure OpenAI (used when AZURE_OPENAI_KEY is set) -----------
AZURE_OPENAI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_OPENAI_KEY=replace-me
AZURE_OPENAI_DEPLOYMENT=gpt-5.2
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ---- Option B: OpenAI (used when Azure is not configured) ----------------
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
