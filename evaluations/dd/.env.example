# ─────────────────────────────────────────────────────────────────────────
# LLM API keys — for GENERATING agent solutions with hosted models.
#
# These are needed ONLY by `python evaluate.py generate ...` (and the framework
# agents). They are NOT required to score an existing agent script
# (`python evaluate.py run ...`), which runs offline.
#
# Copy this file to `.env`; it is auto-loaded from the repo root with
# setdefault semantics (it never overrides a variable already in your shell).
# ─────────────────────────────────────────────────────────────────────────

# --- OpenAI (provider "openai", default model: gpt-5.2) ---
OPENAI_API_KEY=

# --- Azure OpenAI (optional alternative to OpenAI) ---
# Auto-selected when AZURE_OPENAI_ENDPOINT is set. With Azure, the *deployment*
# name is sent in place of the model id (defaults to AZURE_OPENAI_DEPLOYMENT,
# else the requested model name).
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# AZURE_OPENAI_DEPLOYMENT=gpt-5.2

# --- Anthropic (provider "anthropic", default model: claude-sonnet-4-6) ---
ANTHROPIC_API_KEY=

# --- Google Gemini (provider "google", default model: gemini-3-pro-preview) ---
GOOGLE_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Framework-agent knobs (optional; only for the tool-using agents
# claude_code / biomni / tooluniverse described in the README).
# ─────────────────────────────────────────────────────────────────────────
# CLAUDE_CODE_CMD=claude
# BIOMNI_SOURCE=Anthropic
# BIOMNI_LLM=claude-sonnet-4-6
# BIOMNI_TEMPERATURE=0
# BIOMNI_PATH=
