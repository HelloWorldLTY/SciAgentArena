      "proceed_as_is",
      "harmonize_units",
      "collect_more_data",
      "realign_annotations",
      "deduplicate",
      "normalize_to_controls",
      "escalate_to_human",
      "no_action_possible",
      "verify_against_external_db",
      "refresh_from_current_source",
      "inspect_manually",
      "reject_invalid_inputs",
      "repeat_measurement",
      "redefine_objective"
    ]
