{
    "platformName":  "BioMedArena",
    "maxUploadSizeMb":  2000,
    "executionTimeoutSeconds":  900,
    "pythonExecutable":  "python",
    "benchmarks":  {
                       "single-cell":  {
                                           "label":  "Single-Cell RNA-seq",
                                           "tasks":  [
                                                         {
                                                             "id":  "task1",
                                                             "title":  "Read And Harmonize Metadata",
                                                             "summary":  "Load the dataset and normalize batch/cell-type labels into obs[\u0027sample\u0027] and obs[\u0027cell_type\u0027]."
                                                         },
                                                         {
                                                             "id":  "task2",
                                                             "title":  "QC Metrics",
                                                             "summary":  "Annotate mt/ribo/hb genes and compute Scanpy QC metrics."
                                                         },
                                                         {
                                                             "id":  "task3",
                                                             "title":  "Cell And Gene Filtering",
                                                             "summary":  "Filter low-quality cells and low-support genes."
                                                         },
                                                         {
                                                             "id":  "task4",
                                                             "title":  "Doublet Detection",
                                                             "summary":  "Produce Scrublet-style doublet predictions and scores."
                                                         },
                                                         {
                                                             "id":  "task5",
                                                             "title":  "Normalization",
                                                             "summary":  "Preserve counts, normalize to library size, and log-transform."
                                                         },
                                                         {
                                                             "id":  "task6",
                                                             "title":  "HVG + PCA",
                                                             "summary":  "Find highly variable genes and compute PCA embeddings."
                                                         },
                                                         {
                                                             "id":  "task7",
                                                             "title":  "Neighbors + UMAP",
                                                             "summary":  "Build the neighborhood graph, cluster, and compute UMAP."
                                                         },
                                                         {
                                                             "id":  "task8",
                                                             "title":  "Batch Effect Correction",
                                                             "summary":  "Score integration quality using scib-metrics style aggregate outputs."
                                                         },
                                                         {
                                                             "id":  "task9",
                                                             "title":  "Clustering Evaluation",
                                                             "summary":  "Compare predicted clustering labels against cell types."
                                                         },
                                                         {
                                                             "id":  "task10",
                                                             "title":  "Differential Expression",
                                                             "summary":  "Compare discovered marker genes against reference marker sets."
                                                         },
                                                         {
                                                             "id":  "task11",
                                                             "title":  "Trajectory Preservation",
                                                             "summary":  "Estimate trajectory conservation for integration outputs."
                                                         }
                                                     ]
                                       },
                       "spatial":  {
                                       "label":  "Spatial Transcriptomics",
                                       "tasks":  [
                                                     {
                                                         "id":  "task1",
                                                         "title":  "Read And Spatial Metadata",
                                                         "summary":  "Load the dataset, ensure sample labels exist, and validate spatial coordinates."
                                                     },
                                                     {
                                                         "id":  "task2",
                                                         "title":  "QC Metrics",
                                                         "summary":  "Annotate mt/ribo/hb genes and compute Scanpy QC metrics."
                                                     },
                                                     {
                                                         "id":  "task3",
                                                         "title":  "Filtering",
                                                         "summary":  "Filter low-quality spots and low-support genes."
                                                     },
                                                     {
                                                         "id":  "task4",
                                                         "title":  "Normalization",
                                                         "summary":  "Preserve counts, normalize, and log-transform the matrix."
                                                     },
                                                     {
                                                         "id":  "task5",
                                                         "title":  "HVG + PCA",
                                                         "summary":  "Find highly variable genes and compute PCA embeddings."
                                                     },
                                                     {
                                                         "id":  "task6",
                                                         "title":  "Neighbors + UMAP",
                                                         "summary":  "Build the neighborhood graph and compute UMAP."
                                                     },
                                                     {
                                                         "id":  "task7",
                                                         "title":  "Spatial Graph",
                                                         "summary":  "Construct a valid symmetric spatial neighborhood graph in obsp[\u0027spatial_connectivities\u0027]."
                                                     },
                                                     {
                                                         "id":  "task8",
                                                         "title":  "Batch Effect Correction",
                                                         "summary":  "Score batch correction quality on the spatial dataset embeddings."
                                                     },
                                                     {
                                                         "id":  "task9",
                                                         "title":  "Clustering + Spatial Autocorrelation",
                                                         "summary":  "Evaluate clustering against labels and include Global Moran\u0027s I from the spatial graph."
                                                     },
                                                     {
                                                         "id":  "task10",
                                                         "title":  "Spatially Variable Genes",
                                                         "summary":  "Compare predicted SVGs against silver SVG reference lists."
                                                     },
                                                     {
                                                         "id":  "task11",
                                                         "title":  "Neighborhood Enrichment",
                                                         "summary":  "Compare neighborhood enrichment outputs against a Squidpy-computed reference."
                                                     }
                                                 ]
                                   },
                       "perturbation-prediction":  {
                                                       "label":  "Perturbation Prediction",
                                                       "tasks":  [
                                                                     {
                                                                         "id":  "task1",
                                                                         "title":  "Load & Validate Perturbation Data",
                                                                         "summary":  "Load the dataset and validate obs['pert'], obs['cell_type'], and presence of control cells."
                                                                     },
                                                                     {
                                                                         "id":  "task2",
                                                                         "title":  "Prediction Format Validation",
                                                                         "summary":  "Verify that predicted expression is stored in layers['X_pred'] with correct shape, finite values, and obs['split'] labels."
                                                                     },
                                                                     {
                                                                         "id":  "task3",
                                                                         "title":  "Perturbation Prediction Quality",
                                                                         "summary":  "Evaluate prediction accuracy per condition using Pearson correlation (all genes and top-K DE genes), R², MSE, and mean delta error."
                                                                     }
                                                                 ]
                                                   },
                       "ehr":  {
                                   "label":  "Electronic Health Records",
                                   "tasks":  [
                                                 {
                                                     "id":  "task1",
                                                     "title":  "Clinical Data Loading & Validation",
                                                     "summary":  "Load structured EHR data and validate patient record format, required fields, and data integrity constraints."
                                                 },
                                                 {
                                                     "id":  "task2",
                                                     "title":  "Medical Code Normalization",
                                                     "summary":  "Map raw clinical codes to standardized terminologies (ICD-10, SNOMED-CT, RxNorm) and validate against reference code sets."
                                                 },
                                                 {
                                                     "id":  "task3",
                                                     "title":  "Temporal Event Extraction",
                                                     "summary":  "Extract and sequence clinical events from patient timelines, including admissions, diagnoses, medications, and procedures."
                                                 },
                                                 {
                                                     "id":  "task4",
                                                     "title":  "Clinical Outcome Prediction",
                                                     "summary":  "Predict patient outcomes (30-day readmission, in-hospital mortality) from EHR features; scored by F1 between predicted and observed outcomes."
                                                 },
                                                 {
                                                     "id":  "task5",
                                                     "title":  "Treatment Recommendation",
                                                     "summary":  "Match predicted treatment plans against reference interventions using F1 score on the set of recommended clinical actions."
                                                 }
                                             ]
                               },
                       "cross-domain":  {
                                            "label":  "Cross Domain Analysis",
                                            "tasks":  [
                                                          {
                                                              "id":  "task1",
                                                              "title":  "eQTL Mapping & Evaluation",
                                                              "summary":  "Identify expression quantitative trait loci and compare predicted (gene, variant) pairs against a reference eQTL set using per-gene precision, recall, and F1."
                                                          },
                                                          {
                                                              "id":  "task2",
                                                              "title":  "Cross-Omics Association",
                                                              "summary":  "Integrate multi-omics layers (genomics, transcriptomics, epigenomics) and evaluate cross-domain variant-gene associations by exact-match accuracy against reference calls."
                                                          }
                                                      ]
                                        },
                       "drug-discovery":  {
                                              "label":  "Drug Discovery",
                                              "tasks":  [
                                                            {
                                                                "id":  "task1",
                                                                "title":  "Molecular Property Prediction",
                                                                "summary":  "Predict ADMET properties (absorption, distribution, metabolism, excretion, toxicity) for candidate compounds and score against experimental reference values."
                                                            },
                                                            {
                                                                "id":  "task2",
                                                                "title":  "Protein-Ligand Binding Affinity",
                                                                "summary":  "Score binding affinity between small-molecule drug candidates and target proteins; evaluate by Pearson correlation and ranking metrics against experimentally determined values."
                                                            },
                                                            {
                                                                "id":  "task3",
                                                                "title":  "Lead Compound Optimization",
                                                                "summary":  "Generate and rank optimized molecular variants by drug-likeness (QED, SA score, Lipinski filters) and predicted potency improvement over the starting scaffold."
                                                            },
                                                            {
                                                                "id":  "task4",
                                                                "title":  "Drug-Target Interaction Prediction",
                                                                "summary":  "Predict interaction profiles between drug libraries and protein targets; score AUROC and AUPRC against curated positive/negative interaction benchmarks."
                                                            },
                                                            {
                                                                "id":  "task5",
                                                                "title":  "Drug Combination Synergy",
                                                                "summary":  "Predict synergistic drug combinations for therapeutic targets and compare predicted synergy scores against experimental Bliss/Loewe synergy measurements."
                                                            }
                                                        ]
                                          },
                       "statistical-genetics":  {
                                                    "label":  "Statistical Genetics",
                                                    "tasks":  [
                                                                  {
                                                                      "id":  "task1",
                                                                      "title":  "MR Method Documentation & Input Validation",
                                                                      "summary":  "Document the 16 Mendelian Randomization methods, declare IV p-value thresholds, and validate GWAS input files and supporting reference data."
                                                                  },
                                                                  {
                                                                      "id":  "task2",
                                                                      "title":  "GWAS QC & Formatting",
                                                                      "summary":  "Harmonize raw GWAS summary statistics: HapMap 3 restriction, allele QC, MHC exclusion, MAF/INFO filtering, and chi-square outlier removal."
                                                                  },
                                                                  {
                                                                      "id":  "task3",
                                                                      "title":  "Background Parameter Estimation",
                                                                      "summary":  "Estimate LDSC-based Omega and C matrices for MR-APSS using LD-score regression with h2.fix.intercept=FALSE across all exposure-outcome pairs."
                                                                  },
                                                                  {
                                                                      "id":  "task4",
                                                                      "title":  "IV Selection via PLINK LD Clumping",
                                                                      "summary":  "Select independent genetic instruments by PLINK LD clumping (kb=1000, r²=0.001) across four IV p-value thresholds per exposure."
                                                                  },
                                                                  {
                                                                      "id":  "task5",
                                                                      "title":  "Run 16 MR Methods",
                                                                      "summary":  "Execute all 16 Mendelian Randomization methods (IVW, Egger, RAPS, CAUSE, MR-APSS, etc.) and produce per-pair result files with beta, SE, p-value, and IV count."
                                                                  },
                                                                  {
                                                                      "id":  "task6",
                                                                      "title":  "MR Results Aggregation & Evaluation",
                                                                      "summary":  "Aggregate MR results, compute Type-I error rates and accuracy metrics per method and IV threshold, and produce a ranked summary of the 16 methods."
                                                                  },
                                                                  {
                                                                      "id":  "task7",
                                                                      "title":  "PRS Method Selection & Validation",
                                                                      "summary":  "Select a polygenic risk score method (PRS-CS, LDpred2, SBayesR, etc.), document the method card, and validate all required input files including target genotypes and phenotypes."
                                                                  },
                                                                  {
                                                                      "id":  "task8",
                                                                      "title":  "GWAS Sumstats Preprocessing for PRS",
                                                                      "summary":  "Clean, harmonize, and validate GWAS summary statistics for PRS computation: remove duplicates, check allele alignment against target .bim, and subset phenotype/covariate files."
                                                                  },
                                                                  {
                                                                      "id":  "task9",
                                                                      "title":  "PRS Computation",
                                                                      "summary":  "Execute the selected PRS method to generate per-chromosome posterior weights, merge them, and produce PLINK2 .sscore outputs; validate scores against gold-standard Pearson r thresholds."
                                                                  },
                                                                  {
                                                                      "id":  "task10",
                                                                      "title":  "SLURM Pipeline Execution",
                                                                      "summary":  "Submit and monitor the three-stage SLURM pipeline (preprocessing, weights, scoring) with proper SBATCH headers, timing/memory logs, and failure classification."
                                                                  },
                                                                  {
                                                                      "id":  "task11",
                                                                      "title":  "PRS Predictive Evaluation",
                                                                      "summary":  "Assess PRS predictive performance for continuous and binary traits using incremental R², AUC, and Nagelkerke R²; produce an evaluation_summary.tsv with per-trait results."
                                                                  }
                                                              ]
                                                }
